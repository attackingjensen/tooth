{
    "models": {
        "denoiser": {
            "name": "ControlledSLatFlowModel",
            "args": {
                "resolution": 64,
                "in_channels": 8,
                "out_channels": 8,
                "model_channels": 1024,
                "cond_channels": 1024,
                "num_blocks": 24,
                "num_heads": 16,
                "mlp_ratio": 4,
                "patch_size": 2,
                "num_io_res_blocks": 2,
                "io_block_channels": [ 128 ],
                "pe_mode": "ape",
                "qk_rms_norm": true,
                "use_fp16": true
            }
        }
    },
    "dataset": {
        "name": "CrownJawSLat",
        "args": {
            "split": "train",
            "normalize": true
        }
    },
    "trainer": {
        "name": "CrownGeoControlNetSLatTrainer",
        "args": {
            "max_steps": 100000,
            "batch_split": 1,
            "optimizer": { "name": "AdamW", "args": { "lr": 0.0001, "weight_decay": 0.0 } },
            "ema_rate": [ 0.999 ],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "grad_clip": { "name": "AdaptiveGradClipper", "args": { "max_norm": 1.0, "clip_percentile": 95 } },
            "i_print": 50,
            "i_log": 50,
            "i_sample": 99999,
            "i_save": 5000,
            "p_uncond": 0.0,
            "t_schedule": { "name": "logitNormal", "args": { "mean": 1.0, "std": 1.0 } },
            "sigma_min": 1e-05,
            "cond_channels": 1024,
            "num_cond_tokens": 1,
            "controlnet_pretrain": "/mnt/zsn/zsn_workspace/Ctrl-3D/pretrain/slat_flow_img_dit_L_64l8p2_fp16.safetensors",
            "batch_size": 8,
            "batch_size_per_gpu": 4
        }
    }
}
