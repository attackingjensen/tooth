# Copy to env.local and change interpreter paths on the destination machine.
export CROWN_PYTHON=/opt/crown-runtime/bin/python
export CROWN_VOXEL_PYTHON=/opt/crown-voxel/bin/python
export CROWN_HOST=0.0.0.0
export CROWN_PORT=8090
export CROWN_GPUS=auto
export CROWN_MAX_WORKERS=1
export CROWN_MIN_GPU_FREE_MB=35000
export ATTN_BACKEND=flash_attn
export SPARSE_ATTN_BACKEND=flash_attn
export SPARSE_BACKEND=spconv
